<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Сборка под конкретную версию Revit:
        dotnet build -c Release -p:RevitVersion=2023
        dotnet build -c Release -p:RevitVersion=2025
    По умолчанию — Revit 2023.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2023</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>McpRevit</AssemblyName>
    <RootNamespace>McpRevit</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF Condition="'$(RevitVersion)' &gt;= '2025'">true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
  </PropertyGroup>

  <!-- API Revit 2025+ перешёл на 64-разрядный ElementId. -->
  <PropertyGroup Condition="'$(RevitVersion)' &gt;= '2025'">
    <DefineConstants>$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Newtonsoft.Json поставляется вместе с Revit — ссылаемся, но не копируем,
         иначе в процессе Revit окажутся две разные версии сборки. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RevitApiDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Эталонные сборки net48 приезжают из NuGet, иначе на машине пришлось бы
       отдельно ставить .NET Framework 4.8 Developer Pack. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="McpRevit.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
